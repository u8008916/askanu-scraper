ASKANU_ENV=local
DATABASE_URL=
DB_NAME=askanu
DB_USER=askanu_backend
DB_PASSWORD=
CLOUD_SQL_INSTANCE_CONNECTION_NAME=askanu-dev-gdg:australia-southeast1:askanu-postgres-dev
GOOGLE_CLOUD_PROJECT=askanu-dev-gdg
GOOGLE_CLOUD_LOCATION=australia-southeast1
SCRAPER_USER_AGENT=AskANU/0.1
DEFAULT_POLL_CADENCE=DAILY

# One-shot scraper job (non-secret configuration)
SCRAPER_SOURCE_ID=courses_programs_and_courses
SCRAPER_DOMAIN=courses
SCRAPER_ACADEMIC_YEAR=2026
SCRAPER_COURSE_CODE=
SCRAPER_MAX_COURSES=2
SCRAPER_MAX_PROGRAMS=2
SCRAPER_MAX_SCHOLARSHIP_LISTING_PAGES=1
SCRAPER_MAX_SCHOLARSHIP_DETAILS=10
# Keep false until the shared migration and production-equivalent grants are verified.
SCRAPER_SCHOLARSHIP_POSTGRES_APPROVED=false
SCRAPER_MAX_JOBS_LISTING_PAGES=1
SCRAPER_MAX_JOB_DETAILS=10
# Keep false until Qasim approves the Jobs migration/runtime/live DB gate.
SCRAPER_JOBS_POSTGRES_APPROVED=false
SCRAPER_MAX_ACCOMMODATION_DETAILS=10
# Keep false until Qasim/Carmen approve and deploy the Accommodation v1 contract.
SCRAPER_ACCOMMODATION_POSTGRES_APPROVED=false
SCRAPER_MAX_SUPPORT_DETAILS=6
# Keep false until Qasim/Carmen approve and deploy the Support v1 contract.
SCRAPER_SUPPORT_POSTGRES_APPROVED=false
SCRAPER_MAX_EVENTS_LISTING_PAGES=6
SCRAPER_MAX_EVENT_DETAILS=100
SCRAPER_EVENTS_WINDOW_START=2026-09-19
# 43 calendar days makes the frozen interval end 2026-10-31 inclusive.
SCRAPER_EVENTS_WINDOW_DAYS=43
SCRAPER_EXPECTED_EVENT_COUNT=30
# Keep false until the Events migration and Qasim/Carmen approval are cited.
SCRAPER_EVENTS_POSTGRES_APPROVED=false
# Rubric has bounded-ingestion permission but uses an unsupported/change-sensitive API.
# Supply only the exact reviewed capture; there is intentionally no guessed default.
SCRAPER_RUBRIC_SEARCH_ENDPOINT=
SCRAPER_MAX_RUBRIC_LISTING_PAGES=20
SCRAPER_MAX_RUBRIC_DETAILS=250
# Keep false until Qasim reviews the migration, dry-run evidence and release gate.
SCRAPER_RUBRIC_POSTGRES_APPROVED=false
SCRAPER_DRY_RUN=true
SCRAPER_SIMULATE_FETCH_FAILURE=false
SCRAPER_STORAGE_PATH=local-data
SCRAPER_STORAGE_BACKEND=local
SCRAPER_TIMEOUT_SECONDS=30
SCRAPER_MIN_REQUEST_INTERVAL_SECONDS=1
