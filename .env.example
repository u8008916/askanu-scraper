ASKANU_ENV=local
DATABASE_URL=
DB_NAME=askanu
DB_USER=askanu_backend
DB_PASSWORD=
CLOUD_SQL_INSTANCE_CONNECTION_NAME=askanu-dev-gdg:australia-southeast1:askanu-postgres-dev
GOOGLE_CLOUD_PROJECT=askanu-dev-gdg
GOOGLE_CLOUD_LOCATION=australia-southeast1
SCRAPER_USER_AGENT=AskANU/0.1
DEFAULT_POLL_CADENCE=DAILY

# One-shot scraper job (non-secret configuration)
SCRAPER_SOURCE_ID=courses_programs_and_courses
SCRAPER_DOMAIN=courses
SCRAPER_ACADEMIC_YEAR=2026
SCRAPER_COURSE_CODE=
SCRAPER_MAX_COURSES=2
SCRAPER_MAX_PROGRAMS=2
SCRAPER_DRY_RUN=true
SCRAPER_SIMULATE_FETCH_FAILURE=false
SCRAPER_STORAGE_PATH=local-data
SCRAPER_STORAGE_BACKEND=local
SCRAPER_TIMEOUT_SECONDS=30
SCRAPER_MIN_REQUEST_INTERVAL_SECONDS=1
